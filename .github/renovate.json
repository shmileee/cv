{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":enablePreCommit"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-5 * * 1"],
  "updateNotScheduled": false,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "groupSingleUpdates": true,
  "semanticCommits": "enabled",
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "semanticCommitType": "fix",
    "semanticCommitScope": "security"
  },
  "packageRules": [
    {
      "description": "Use CI commit semantics for GitHub Actions",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps",
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Group the tools that build and validate this repository",
      "matchManagers": ["mise", "pre-commit"],
      "groupName": "development dependencies",
      "groupSlug": "development-dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "tooling"
    },
    {
      "description": "Skip lock-file maintenance for Mise without lockfiles",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "description": "Allow for the slower release cadence of stable tooling",
      "matchPackageNames": ["koalaman/shellcheck"],
      "abandonmentThreshold": "2 years"
    }
  ]
}
