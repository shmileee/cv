root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true


# Bullet text in the CV is one long logical line per point; hard wrapping it
# would put line breaks in the middle of sentences in the generated PDF.
[*.{tex,cls}]
max_line_length = off

[*.md]
indent_size = 4

[[shell]]
binary_next_line = true
space_redirects = true
switch_case_indent = true
