root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true


# .tex inherits the 80 above, and the bullet text is wrapped to it. A newline
# inside a paragraph is a space to TeX, so wrapping the source changes nothing
# in the PDF: only a blank line or an explicit \\ breaks a line in the output.
#
# altacv.cls is the exception, and not for typesetting reasons: it is vendored
# from upstream v1.1.5 with one marked local change, longest line 324
# characters. Reformatting it would be a diff against upstream to re-apply on
# every version bump, for a file nobody edits by hand.
[*.cls]
max_line_length = off

[*.md]
indent_size = 4

[[shell]]
binary_next_line = true
space_redirects = true
switch_case_indent = true
